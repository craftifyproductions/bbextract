# Copy to .env locally and set the same values in Vercel/Netlify environment variables.
# Do not commit .env.

# Supabase browser config (anon public key only; never use the service role key in VITE_ vars).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_STORAGE_BUCKET=bbextract

# Server-only — required for RAG embed backfill into rag_models (never VITE_).
# SUPABASE_SERVICE_ROLE_KEY=

# Legacy server password auth is no longer used by the frontend, but the Express server still
# validates these when started directly.

BBEXTRACT_PASSWORD=
SESSION_SECRET=

# Cloudflare R2 server-side storage. These must stay server-only; do not use VITE_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=bbextract
# RAG corpus bucket (model.json + label.json only). Same R2 credentials must access it.
R2_VECTOR_BUCKET=vector-db
# Optional prefix inside vector-db (leave empty for cow/model.json at bucket root).
# R2_VECTOR_PREFIX=
# Optional: override endpoint or max upload size.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_MAX_UPLOAD_MB=100

# Optional: total storage quota shown in the sidebar (default 10 GB).
# VITE_STORAGE_QUOTA_GB=10

# Google AI Studio / Gemini (server-only). Used by Generate → 2D.
# Get a key from https://aistudio.google.com/apikey — do not use VITE_.
GEMINI_API_KEY=
# Optional override. Official Nano Banana getting-started model:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Used by RAG prepare scripts / batch auto-label for smart label.json generation:
# GEMINI_LABEL_MODEL=gemini-3.1-flash-lite
# Safety caps (Flash-Lite free-tier style):
# GEMINI_LABEL_RPM=15
# GEMINI_LABEL_TPM=250000
# GEMINI_LABEL_RPD=500
# RAG_BATCH_MAX_PER_RUN=100

# Groq (server-only) — optional / legacy.
GROQ_API_KEY=

# NVIDIA NIM (server-only) — used for NVIDIA RAG vision models (direct API).
# Get a key from https://build.nvidia.com — do not use VITE_.
NVIDIA_API_KEY=

# OpenRouter (server-only) for RAG vision auto-label + embeddings.
# Get a key from https://openrouter.ai/keys — do not use VITE_.
OPENROUTER_API_KEY=
# OPENROUTER_LABEL_MODEL=google/gemini-3.5-flash
# OPENROUTER_LABEL_RPM=20
# OPENROUTER_LABEL_TPM=200000
# OPENROUTER_LABEL_RPD=2000
# Default embedding model (must be able to return RAG_EMBEDDING_DIMS):
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# RAG_EMBEDDING_DIMS=1536
# RAG_EMBED_MAX_PER_RUN=500
# Optional attribution headers for OpenRouter rankings:
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=BBExtract

# Cloudflare Worker free image API (server-only).
# POST JSON { prompt } with Authorization: Bearer <key>, returns image bytes.
CF_WORKER_IMAGE_URL=https://free-image-generation-api.sagnik2000trainstation.workers.dev
CF_WORKER_IMAGE_API_KEY=

# Optional
PORT=3001
